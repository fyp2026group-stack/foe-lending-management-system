# Runtime: Supabase transaction pooler (or local PostgreSQL)
DATABASE_URL="postgresql://lab_runtime.PROJECT_REF:PASSWORD@HOST.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Restricted ORM role: provision grants before using (not the postgres owner)
ORM_DATABASE_URL="postgresql://lab_orm.PROJECT_REF:PASSWORD@HOST.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Prisma CLI migrations: direct Supabase connection or session pooler
MIGRATION_DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"
APP_ORIGIN="https://your-application.vercel.app"
DATABASE_POOL_SIZE=5
# Never commit a populated .env file. URLs above are placeholders.
