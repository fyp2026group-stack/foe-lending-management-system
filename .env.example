# Server-only runtime: restricted Supabase transaction pooler (required).
ORM_DATABASE_URL="postgresql://lab_orm.PROJECT_REF:PASSWORD@HOST.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct or session-pooled migration-owner connection. Never expose to the browser.
MIGRATION_DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# Optional compatibility: used by isolated historical SQL verification scripts,
# not required for any Next.js application request.
# DATABASE_URL="postgresql://lab_runtime:PASSWORD@localhost:5432/lab_inventory"

APP_ORIGIN="https://your-application.example"
DATABASE_POOL_SIZE=5

# Never commit real passwords or expose credentials as NEXT_PUBLIC_* variables.
