model batches {
  id                     String                   @id @db.Uuid
  name                   String                   @unique
  active                 Boolean                  @default(true)
  user_batch_memberships user_batch_memberships[]
  users                  users[]

  @@schema("lab")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model denial_suppression {
  singleton          Boolean  @id
  suppressed         BigInt
  last_suppressed_at DateTime @db.Timestamptz(6)

  @@schema("lab")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model google_student_identities {
  google_subject String   @id
