generator client {
  // Temporary compatibility generator for Next.js/Turbopack API compilation.
  // The default TypeScript-source generator was not resolved at runtime.
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["lab"]
}

model audit {
  id          String   @id @db.Uuid
  actor_id    String?  @db.Uuid
  action      String
  target_id   String?  @db.Uuid
  occurred_at DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  details     Json?
  users       users?   @relation(fields: [actor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("lab")
}

