// Read-only mapping of selected existing tables. The authoritative schema is
// database/*.sql, including SQL functions, constraints, privileges and triggers.
// Never use `prisma migrate` or `prisma db push` on this database.
// Regenerate the model snapshot after controlled SQL migrations using
// `npm run prisma:introspect` against an isolated copy.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["lab"]
}

model InventoryCategory {
  id      String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name    String  @unique
  active  Boolean @default(true)
  version Int     @default(0)

  @@map("inv_categories")
  @@schema("lab")
}

model InventoryItem {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId     String  @map("category_id") @db.Uuid
  name           String
  kind           String
  uom            String
  active         Boolean @default(true)
  version        Int     @default(0)
  specifications Json    @default("{}")

  @@map("inv_items")
  @@schema("lab")
}

model Laboratory {
  id   String @id @db.Uuid
  name String @unique

  @@map("laboratories")
  @@schema("lab")
}

model BorrowRequest {
  id            String   @id @db.Uuid
  borrowerId    String   @map("borrower_id") @db.Uuid
  purpose       String
  collectAt     DateTime @map("collect_at") @db.Timestamptz(6)
  returnAt      DateTime @map("return_at") @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  predecessorId String?  @unique @map("predecessor_id") @db.Uuid
  revision      Int      @default(1)
  version       Int      @default(0)

  @@map("lend_requests")
  @@schema("lab")
}

model BorrowLine {
  id         String  @id @db.Uuid
  requestId  String  @map("request_id") @db.Uuid
  itemId     String  @map("item_id") @db.Uuid
  labId      String  @map("lab_id") @db.Uuid
  locationId String  @map("location_id") @db.Uuid
  quantity   Int
  policy     String
  lecturerId String? @map("lecturer_id") @db.Uuid
  hodId      String? @map("hod_id") @db.Uuid
  stage      String
  version    Int     @default(0)
  cancelled  Int     @default(0)

  @@map("lend_lines")
  @@schema("lab")
}

model BorrowDecision {
  id        String   @id @db.Uuid
  lineId    String   @map("line_id") @db.Uuid
  actorId   String   @map("actor_id") @db.Uuid
  stage     String
  decision  String
  remarks   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([lineId, stage])
  @@map("lend_decisions")
  @@schema("lab")
}

model BorrowDraft {
  id            String   @id @db.Uuid
  borrowerId    String   @map("borrower_id") @db.Uuid
  payload       Json
  version       Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  submittedId   String?  @unique @map("submitted_id") @db.Uuid
  cancelled     Boolean  @default(false)
  predecessorId String?  @unique @map("predecessor_id") @db.Uuid

  @@map("lend_drafts")
  @@schema("lab")
}
