  verified_email String
  created_at     DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  users          users    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("lab")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model inv_adjustments {
  id                                    String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  proposer                              String         @db.Uuid
  item_id                               String         @db.Uuid
  lab_id                                String         @db.Uuid
  location_id                           String         @db.Uuid
  quantity                              Int
  direction                             String
  reason                                String
  expected_version                      Int
  state                                 String         @default("PENDING")
  approver                              String?        @db.Uuid
  movement_id                           String?        @db.Uuid
  users_inv_adjustments_approverTousers users?         @relation("inv_adjustments_approverTousers", fields: [approver], references: [id], onDelete: NoAction, onUpdate: NoAction)
  inv_items                             inv_items      @relation(fields: [item_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  laboratories                          laboratories   @relation(fields: [lab_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  inv_locations                         inv_locations  @relation(fields: [location_id, lab_id], references: [id, lab_id], onDelete: NoAction, onUpdate: NoAction)
  inv_movements                         inv_movements? @relation(fields: [movement_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_inv_adjustments_proposerTousers users          @relation("inv_adjustments_proposerTousers", fields: [proposer], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("lab")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model inv_assets {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  item_id              String                @db.Uuid
  lab_id               String                @db.Uuid
  serial               String?
  created_at           DateTime              @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  inv_items            inv_items             @relation(fields: [item_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  laboratories         laboratories          @relation(fields: [lab_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  inv_cells            inv_cells[]
  lend_inspections     lend_inspections[]
  lend_loans           lend_loans[]
  lend_reserved_assets lend_reserved_assets?

  @@unique([id, item_id, lab_id])
  @@unique([item_id, serial])
  @@schema("lab")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model inv_categories {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String      @unique
  active    Boolean     @default(true)
  version   Int         @default(0)
  inv_items inv_items[]

  @@schema("lab")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model inv_cells {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  item_id              String                 @db.Uuid
  lab_id               String                 @db.Uuid
  location_id          String                 @db.Uuid
  asset_id             String?                @unique(map: "inv_one_active_asset", where: raw("((asset_id IS NOT NULL) AND (quantity = 1))")) @db.Uuid
  state                String
  quantity             Int                    @default(0)
  version              Int                    @default(0)
  inv_assets           inv_assets?            @relation(fields: [asset_id, item_id, lab_id], references: [id, item_id, lab_id], onDelete: NoAction, onUpdate: NoAction)
  inv_items            inv_items              @relation(fields: [item_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  laboratories         laboratories           @relation(fields: [lab_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  inv_locations        inv_locations          @relation(fields: [location_id, lab_id], references: [id, lab_id], onDelete: NoAction, onUpdate: NoAction)
  inv_entries          inv_entries[]
  lend_allocations     lend_allocations[]
  lend_reserved_assets lend_reserved_assets[]

  @@unique([item_id, lab_id, location_id, asset_id, state])
  @@index([lab_id, item_id, state, id], map: "inv_scope")
  @@schema("lab")
}

