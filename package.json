{
  "name": "lab-inventory-foundation",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "local:config": "node scripts/local.mjs config",
    "db:up": "node scripts/local.mjs db:up",
    "db:down": "node scripts/local.mjs db:down",
    "db:setup": "node scripts/local.mjs db:setup",
    "db:migrate": "node scripts/local.mjs db:migrate",
    "db:seed": "node scripts/local.mjs db:seed",
    "db:verify": "node scripts/local.mjs db:verify",
    "db:shell": "node scripts/local.mjs db:shell",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "prisma generate --config prisma7.config.ts && tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "prisma:generate": "prisma generate --config prisma7.config.ts",
    "prisma:validate": "prisma validate --config prisma7.config.ts",
    "prisma:introspect": "prisma db pull --config prisma7.config.ts",
    "prisma:format": "prisma format --config prisma7.config.ts",
    "postinstall": "prisma generate --config prisma7.config.ts",
    "prebuild": "prisma generate --config prisma7.config.ts",
    "prisma:deploy": "npm run prisma:readiness:enforce && prisma migrate deploy --config prisma7.config.ts",
    "prisma:status": "prisma migrate status --config prisma7.config.ts",
    "prisma:diff": "prisma migrate diff --config prisma7.config.ts",
    "prisma:readiness": "node scripts/prisma-readiness.mjs",
    "prisma:readiness:enforce": "node scripts/prisma-readiness.mjs --enforce"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-slot": "1.5.0",
    "@tanstack/react-table": "9.3.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fflate": "0.8.3",
    "lucide-react": "1.70.0",
    "next": "16.4.5",
    "pg": "8.23.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "read-excel-file": "9.3.14",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "unzipper-esm": "0.13.3",
    "vaul": "1.1.2",
    "@prisma/client": "7.10.1",
    "@prisma/adapter-pg": "7.10.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.5",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "prisma": "7.10.1"
  },
  "overrides": {
    "minimatch@>=7 <11.0.1": "11.0.1"
  },
  "type": "module"
}
