  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-lab-session",
        "description": "Proposed revocable opaque DB session; Secure HttpOnly Path=/; SameSite/lifetimes and P15 unresolved."
      }
    },
    "schemas": {
      "Id": {
        "type": "string",
        "format": "uuid"
      },
      "Version": {
        "type": "integer",
        "minimum": 0
      },
      "Submission": {
        "type": "object",
        "additionalProperties": false,
        "required": ["revisionId"],
        "properties": {
          "revisionId": {
            "$ref": "#/components/schemas/Id"
          }
        }
      },
      "Decision": {
        "type": "object",
        "additionalProperties": false,
        "required": ["revisionId", "lineId", "decision", "reason"],
        "properties": {
          "revisionId": {
            "$ref": "#/components/schemas/Id"
          },
          "lineId": {
            "$ref": "#/components/schemas/Id"
          },
          "decision": {
            "enum": ["approve", "reject"]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      },
      "Asset": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "assetId", "quantity"],
        "properties": {
          "kind": {
            "const": "returnable"
          },
          "assetId": {
            "$ref": "#/components/schemas/Id"
          },
          "quantity": {
            "type": "integer",
            "const": 1
          }
        }
      },
      "Consumable": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "itemId", "quantity"],
        "properties": {
          "kind": {
            "const": "consumable"
          },
          "itemId": {
            "$ref": "#/components/schemas/Id"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "Return": {
        "type": "object",
        "additionalProperties": false,
        "required": ["issueId", "assetId", "quantity", "condition"],
        "properties": {
          "issueId": {
            "$ref": "#/components/schemas/Id"
          },
          "assetId": {
            "$ref": "#/components/schemas/Id"
          },
          "quantity": {
            "type": "integer",
            "const": 1
          },
          "condition": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      },
      "Result": {
        "type": "object",
        "additionalProperties": false,
        "required": ["eventId", "version", "correlationId"],
        "properties": {
          "eventId": {
            "$ref": "#/components/schemas/Id"
          },
          "version": {
            "$ref": "#/components/schemas/Version"
          },
          "correlationId": {
            "$ref": "#/components/schemas/Id"
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "correlationId"],
        "properties": {
          "code": {
            "enum": [
              "UNAUTHENTICATED",
              "DENIED",
              "NOT_FOUND",
              "IN_PROGRESS",
              "IDENTITY_CONFLICT",
              "STALE_VERSION",
              "POLICY_UNRESOLVED",
              "INVALID",
              "LIMITED",
              "UNAVAILABLE"
            ]
          },
          "correlationId": {
            "$ref": "#/components/schemas/Id"
          }
        }
      },
      "Handover": {
        "type": "object",
        "additionalProperties": false,
        "required": ["revisionId", "lineId", "approvedTermsId", "stock"],
        "properties": {
          "revisionId": {
            "$ref": "#/components/schemas/Id"
          },
          "lineId": {
            "$ref": "#/components/schemas/Id"
          },
          "approvedTermsId": {
            "$ref": "#/components/schemas/Id"
          },
          "stock": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Asset"
              },
              {
                "$ref": "#/components/schemas/Consumable"
              }
            ],
            "discriminator": {
              "propertyName": "kind",
              "mapping": {
                "returnable": "#/components/schemas/Asset",
                "consumable": "#/components/schemas/Consumable"
              }
            }
          }
        }
      },
      "SubmissionCommand": {
        "type": "object",
        "additionalProperties": false,
        "required": ["intentId", "expectedVersion", "data"],
        "properties": {
          "intentId": {
            "$ref": "#/components/schemas/Id"
          },
          "expectedVersion": {
            "$ref": "#/components/schemas/Version"
          },
          "data": {
            "$ref": "#/components/schemas/Submission"
          }
        }
      },
      "DecisionCommand": {
        "type": "object",
        "additionalProperties": false,
        "required": ["intentId", "expectedVersion", "data"],
        "properties": {
          "intentId": {
            "$ref": "#/components/schemas/Id"
          },
          "expectedVersion": {
            "$ref": "#/components/schemas/Version"
          },
          "data": {
            "$ref": "#/components/schemas/Decision"
          }
        }
      },
      "HandoverCommand": {
        "type": "object",
        "additionalProperties": false,
        "required": ["intentId", "expectedVersion", "data"],
        "properties": {
          "intentId": {
            "$ref": "#/components/schemas/Id"
          },
          "expectedVersion": {
            "$ref": "#/components/schemas/Version"
          },
          "data": {
            "$ref": "#/components/schemas/Handover"
          }
        }
      },
      "ReturnCommand": {
        "type": "object",
        "additionalProperties": false,
        "required": ["intentId", "expectedVersion", "data"],
        "properties": {
          "intentId": {
            "$ref": "#/components/schemas/Id"
          },
          "expectedVersion": {
            "$ref": "#/components/schemas/Version"
          },
          "data": {
            "$ref": "#/components/schemas/Return"
          }
        }
      },
      "Status": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["state", "correlationId"],
            "properties": {
              "state": {
                "const": "pending"
              },
              "correlationId": {
                "$ref": "#/components/schemas/Id"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["state", "result", "correlationId"],
            "properties": {
              "state": {
                "const": "committed"
              },
              "result": {
                "$ref": "#/components/schemas/Result"
              },
              "correlationId": {
                "$ref": "#/components/schemas/Id"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["state", "error", "correlationId"],
            "properties": {
              "state": {
                "const": "rejected"
              },
              "error": {
                "$ref": "#/components/schemas/Error"
              },
              "correlationId": {
                "$ref": "#/components/schemas/Id"
              }
            }
          }
        ]
      }
    }
  }
}
