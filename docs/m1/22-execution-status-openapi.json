  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-lab-session",
        "description": "Opaque revocable DB session; Secure HttpOnly; parameters unresolved."
      }
    },
    "parameters": {
      "K": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/U"
        },
        "description": "Actor+execute+operation+target namespace distinct creation."
      },
      "C": {
        "name": "X-CSRF-Token",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "description": "Validated session-bound token plus origin."
      }
    },
    "responses": {
      "E": {
        "description": "401 session;403 denied/concealed404;409 identity/stale/in-progress/policy;422 invalid;429 limited;503 unavailable/unknown commit. SEMANTIC_REJECTED maps409 only after durable rejection. No blind physical retry.",
        "headers": {
          "Cache-Control": {
            "schema": {
              "const": "no-store"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "U": {
        "type": "string",
        "format": "uuid"
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "correlationId"
        ],
        "properties": {
          "code": {
            "enum": [
              "UNAUTHENTICATED",
              "DENIED",
              "NOT_FOUND",
              "IDENTITY_CONFLICT",
              "STALE_VERSION",
              "IN_PROGRESS",
              "POLICY_UNRESOLVED",
              "INVALID",
              "LIMITED",
              "UNAVAILABLE",
              "COMMIT_UNKNOWN",
              "SEMANTIC_REJECTED"
            ]
          },
          "correlationId": {
            "$ref": "#/components/schemas/U"
          }
        }
      },
      "P": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "intentId",
          "slotId",
          "state"
        ],
        "properties": {
          "intentId": {
            "$ref": "#/components/schemas/U"
          },
          "slotId": {
            "$ref": "#/components/schemas/U"
          },
          "state": {
            "const": "pending"
          }
        }
      },
      "J": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "intentId",
          "slotId",
          "state",
          "error"
        ],
        "properties": {
          "intentId": {
            "$ref": "#/components/schemas/U"
          },
          "slotId": {
            "$ref": "#/components/schemas/U"
          },
          "state": {
            "const": "rejected"
          },
          "error": {
            "$ref": "#/components/schemas/Error"
          }
        }
      },
      "S": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation",
          "revisionId"
        ],
        "properties": {
          "operation": {
            "const": "submission"
          },
          "revisionId": {
            "$ref": "#/components/schemas/U"
          }
        }
      },
      "A": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation",
          "decisionId"
        ],
        "properties": {
          "operation": {
            "const": "decision"
          },
          "decisionId": {
            "$ref": "#/components/schemas/U"
          }
        }
      },
      "I": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation",
          "loanLineId",
          "assetId",
          "custodyGenerationId",
          "quantity"
        ],
        "properties": {
          "operation": {
            "enum": [
              "existingIssue",
              "materializeIssue"
            ]
          },
          "loanLineId": {
            "$ref": "#/components/schemas/U"
          },
          "assetId": {
            "$ref": "#/components/schemas/U"
          },
          "custodyGenerationId": {
            "$ref": "#/components/schemas/U"
          },
          "quantity": {
            "type": "integer",
            "const": 1
          }
        }
      },
      "C": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation",
          "quantity"
        ],
        "properties": {
          "operation": {
            "const": "consume"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "T": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation",
          "receiptId",
          "inspectionId"
        ],
        "properties": {
          "operation": {
            "const": "return"
          },
          "receiptId": {
            "$ref": "#/components/schemas/U"
          },
          "inspectionId": {
            "$ref": "#/components/schemas/U"
          }
        }
      },
      "D": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "intentId",
          "slotId",
          "state",
          "eventId",
          "result"
        ],
        "properties": {
          "intentId": {
            "$ref": "#/components/schemas/U"
          },
          "slotId": {
            "$ref": "#/components/schemas/U"
          },
          "state": {
            "const": "committed"
          },
          "eventId": {
            "$ref": "#/components/schemas/U"
          },
          "result": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/S"
              },
              {
                "$ref": "#/components/schemas/A"
              },
              {
                "$ref": "#/components/schemas/I"
              },
              {
                "$ref": "#/components/schemas/C"
              },
              {
                "$ref": "#/components/schemas/T"
              }
            ]
          }
        }
      },
      "Status": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/P"
          },
          {
            "$ref": "#/components/schemas/D"
          },
          {
            "$ref": "#/components/schemas/J"
          }
        ]
      },
      "Body": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "intentId",
          "slotId"
        ],
        "properties": {
          "intentId": {
            "$ref": "#/components/schemas/U"
          },
          "slotId": {
            "$ref": "#/components/schemas/U"
          }
        }
      }
    }
  }
